# Copy this file to .env and fill in the values from your Firebase project's Web App config.
# See README.md -> "Firebase setup" for exact click-by-click steps.
# These are all public client identifiers (safe to expose in the browser) - not secrets.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Messaging -> Web configuration -> "Web Push certificates" -> Key pair
VITE_FIREBASE_VAPID_KEY=

# Leave blank for local dev (uses the Vite proxy to localhost:4000). In production, set this to
# your deployed backend's full API origin, e.g. https://bloodlink-api.onrender.com/api
VITE_API_BASE_URL=
