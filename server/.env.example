# Copy this file to .env and fill in the values from your Firebase project.
# See README.md -> "Firebase setup" for exact click-by-click steps.
#
# Only ONE of these two is needed - the path is simpler (just save the downloaded file):

# Path to the service account JSON file you downloaded from
# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# ...or paste the entire JSON file's contents here as one line instead:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}

PORT=4000
